# ==============================================================================
# Flux Environment Variables
# ==============================================================================

# Database
# PostgreSQL connection string (matches default docker-compose.yml configuration)
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/flux"

# Better Auth Configuration
# Secret key used for signing cookies and tokens (minimum 32 characters)
BETTER_AUTH_SECRET="dev-secret-change-me-please-use-a-long-random-value"
# Base URL for Better Auth authentication endpoints
BETTER_AUTH_URL="http://localhost:3000"

# Application Settings
# Public application URL (used in client-side webhook URLs and redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# 32-character encryption key for securely storing user API keys and credentials
ENCRYPTION_KEY="replace-with-a-32-character-key-123"

# Authentication Providers (Optional)
# Set to "true" to display and enable OAuth login buttons in the UI
NEXT_PUBLIC_ENABLE_GITHUB_AUTH="false"
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH="false"

# GitHub OAuth credentials (required if GitHub auth is enabled)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth credentials (required if Google auth is enabled)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Polar Billing & Subscriptions (Optional)
# Access token from your Polar.sh account for pro subscription checkout & portal
POLAR_ACCESS_TOKEN=""
POLAR_SUCCESS_URL="http://localhost:3000/dashboard/billing"

# Webhook Tunneling (Optional - for local testing with Stripe/Google Forms triggers)
# Used when running 'npm run ngrok:dev'
NGROK_URL=""

# Internal Service Authentication
# Shared secret for secure service-to-service communication between the Next.js app (Vercel)
# and the standalone market listener (AWS EC2).
# Generate a real random value (e.g. `openssl rand -hex 32`) and set the exact same value in both places.
INTERNAL_API_SECRET=""
